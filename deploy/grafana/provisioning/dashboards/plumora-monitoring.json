{
  "id": null,
  "uid": "plumora-monitoring",
  "title": "Plumora — Monitoring",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API disponible",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "up{job=\"plumora-backend\"}",
          "legendFormat": "API",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "noValue": "DOWN"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU backend",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "process_cpu_usage * 100",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 90, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mémoire JVM (heap)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "Heap utilise",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "value": null, "color": "blue" }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requetes HTTP / seconde",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "Requetes/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Erreurs HTTP 5xx / seconde",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "Erreurs 5xx/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temps moyen de reponse",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_sum[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "Temps moyen",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "CPU hote (VPS)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"node\", mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU hote",
          "refId": "A"
        }
      ],
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 90, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Memoire hote (VPS)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}))",
          "legendFormat": "Memoire hote",
          "refId": "A"
        }
      ],
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 90, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "Disque hote (VPS)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "100 - ((node_filesystem_avail_bytes{job=\"node\", mountpoint=\"/\", fstype!=\"\"} / node_filesystem_size_bytes{job=\"node\", mountpoint=\"/\", fstype!=\"\"}) * 100)",
          "legendFormat": "Disque hote",
          "refId": "A"
        }
      ],
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 85, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Connexions PostgreSQL",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "sum(pg_stat_database_numbackends{job=\"postgres\"})",
          "legendFormat": "Connexions",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "blue" }] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Taille base de donnees",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "pg_database_size_bytes{job=\"postgres\", datname=\"plumora\"}",
          "legendFormat": "Taille",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "blue" }] }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Cache hit ratio PostgreSQL",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "plumora-prometheus" },
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\"}[5m])))",
          "legendFormat": "Cache hit ratio",
          "refId": "A"
        }
      ],
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 90, "color": "yellow" },
              { "value": 99, "color": "green" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Logs (backend / frontend-web / caddy / postgres)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "plumora-loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "plumora-loki" },
          "expr": "{job=\"dockerlogs\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
